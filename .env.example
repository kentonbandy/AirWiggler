# Copy this file to .env and adjust values for local development.
# Real environment variables always take precedence over .env entries.

MUSIC_DIR=C:\path\to\your\music
APP_PORT=8080
SITE_TITLE=My Music Library
DEFAULT_QUALITY=high
RESCAN_ON_START=true
RESCAN_INTERVAL_MINUTES=15

# Set to false when testing locally over plain HTTP (no HTTPS).
COOKIE_SECURE=false

# Optional — leave blank to disable access control.
# ACCESS_TOKEN and AUTH_PROXY_HEADER are mutually exclusive; AUTH_PROXY_HEADER takes priority if both are set.
ACCESS_TOKEN=

# Optional — header-based auth for use behind an OIDC/SSO reverse proxy (e.g. Authelia, Authentik).
# Set to the header name your proxy stamps on authenticated requests (e.g. Remote-User).
# Leave blank to disable. The container port must NOT be reachable directly from the internet.
AUTH_PROXY_HEADER=

# Optional — ntfy push notifications for suspicious activity.
# Leave NOTIFY_URL blank to disable. Use an unguessable topic name.
# See docs/notifications.md for full setup instructions.
NOTIFY_URL=
NOTIFY_BRUTE_FORCE_THRESHOLD=20
NOTIFY_AUTH_GRANT_THRESHOLD=10
